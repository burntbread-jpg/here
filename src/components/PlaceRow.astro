---
// 목록 한 줄. 지도 패널의 목록(scripts/map/places.ts placeRow)과 같은 모양이다.
import CatChip from './CatChip.astro';
import type { Place } from '../lib/data';
import { thumbStyle } from '../scripts/map/places';
import { thumb } from '../lib/photos';
interface Props { place: Place; index: number }
const { place: p, index } = Astro.props;
const t = p.photos?.[0] ? await thumb(p.photos[0]) : null;
---
<li class="place-row border-b border-[var(--color-linen)]" data-sido={p.sido}>
  <a href={`/place/${p.id}`} class="row group grid grid-cols-[2.25rem_1fr_auto] items-center gap-x-4 py-4 sm:grid-cols-[3rem_1fr_9rem_auto] sm:gap-x-6">
    <span class="num self-start pt-1 text-[12px] text-[var(--color-caption)]">{String(index + 1).padStart(2, '0')}</span>
    <span class="min-w-0">
      <span class="display block truncate text-[19px] leading-snug sm:text-[21px]">{p.title}</span>
      <span class="mt-1 block truncate text-[13px] text-[var(--color-caption)]">{p.sido} {p.sgg} · {p.author}</span>
      <span class="mt-2 flex items-center gap-1">
        <CatChip id={p.primary} />{p.secondary.map((s) => <CatChip id={s} />)}
      </span>
    </span>
    <span class="num hidden text-right text-[12.5px] text-[var(--color-caption)] sm:block">{p.date.replaceAll('-', '.')}</span>
    <span class="size-16 shrink-0 overflow-hidden rounded-[2px] sm:size-20">
      {t
        ? <img src={t} alt="" loading="lazy" width="320" height="320" class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
        : <span class="block size-full transition-transform duration-300 group-hover:scale-[1.03]" style={thumbStyle(p)}></span>}
    </span>
  </a>
</li>
