---
// 지도 위에 떠 있는 상단 바. 지도가 주인공이므로 높이를 낮게, 배경은 반투명 종이.
interface Props { current?: string }
const { current = 'map' } = Astro.props;
const nav = [
  { id: 'map', label: '지도', href: '/' },
  { id: 'list', label: '목록', href: '#' },
  { id: 'course', label: '코스', href: '/drafts/c' },
  { id: 'about', label: '소개', href: '#' },
];
---
<header class="pointer-events-none absolute inset-x-0 top-0 z-30 flex items-start justify-between gap-3 p-3 sm:p-4">
  <div class="pointer-events-auto flex items-center gap-1 rounded-2xl bg-[color-mix(in_oklab,var(--color-paper)_88%,transparent)] py-1.5 pr-1.5 pl-3.5 shadow-[0_1px_2px_rgb(0_0_0/.06),0_0_0_1px_rgb(0_0_0/.06)] backdrop-blur-md">
    <a href="/" class="mr-2 flex items-baseline gap-1.5" aria-label="HERE 홈">
      <span class="font-[family-name:var(--font-latin)] text-[17px] font-extrabold tracking-[0.14em]">HERE</span>
      <span class="hidden font-[family-name:var(--font-serif)] text-[12px] text-[var(--color-ink-3)] sm:inline">여기, 가까운 곳</span>
    </a>
    <nav class="hidden items-center md:flex" aria-label="주요 메뉴">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.id === current ? 'page' : undefined}
          class="rounded-xl px-3 py-1.5 text-[14px] text-[var(--color-ink-2)] transition-colors duration-150 hover:bg-black/5 aria-[current=page]:bg-[var(--color-ink)] aria-[current=page]:text-[var(--color-paper)]">{n.label}</a>
      ))}
    </nav>
  </div>
  <div class="pointer-events-auto flex items-center gap-2">
    <a href="https://elsewhere-travel-archive.vercel.app/" class="hidden rounded-xl px-3 py-2 font-[family-name:var(--font-latin)] text-[12px] font-semibold tracking-[0.12em] text-[var(--color-ink-3)] transition-colors hover:text-[var(--color-ink)] lg:block">ELSEWHERE ↗</a>
    <a href="/admin" class="rounded-xl bg-[var(--color-ink)] px-3.5 py-2 text-[13.5px] font-medium text-[var(--color-paper)] shadow-sm transition-transform duration-150 active:scale-[.97]">편집</a>
  </div>
</header>
