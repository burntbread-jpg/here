---
// 지도 + 패널 골격. 데스크톱: 왼쪽 패널 / 모바일: 아래에서 올라오는 시트.
import SiteHeader from './SiteHeader.astro';
interface Props { current?: string }
const { current } = Astro.props;
---
<div class="relative h-dvh w-full">
  <div class="absolute inset-0"><div id="map" class="h-full w-full" aria-label="장소 지도" role="region"></div></div>
  <SiteHeader current={current} />
  <slot name="top" />
  <aside id="panel" data-state="peek" class="panel absolute z-20 flex flex-col overflow-hidden bg-[var(--color-paper)]
      inset-x-0 bottom-0 border-t border-[var(--color-linen)]
      md:inset-x-auto md:top-[68px] md:bottom-6 md:left-6 md:w-[360px] md:border md:border-[var(--color-linen)]">
    <button type="button" id="sheet-handle" class="flex h-7 w-full shrink-0 items-center justify-center md:hidden" aria-label="목록 펼치기" aria-expanded="false">
      <span class="h-[3px] w-9 rounded-full bg-[var(--color-taupe)] opacity-60"></span>
    </button>
    <slot name="panel" />
  </aside>
  <slot />
</div>
<style>
  .panel { transition: height 320ms var(--ease-out); box-shadow: 0 1px 0 rgb(36 35 31 / .02), 0 12px 32px -12px rgb(36 35 31 / .12); }
  @media (max-width: 767.98px) {
    .panel { border-radius: 10px 10px 0 0; }
    .panel[data-state='peek'] { height: 176px; }
    .panel[data-state='open'] { height: 64dvh; }
  }
</style>
<script>
  const panel = document.getElementById('panel')!;
  const handle = document.getElementById('sheet-handle')!;
  handle.addEventListener('click', () => {
    panel.dataset.state = panel.dataset.state === 'open' ? 'peek' : 'open';
    handle.setAttribute('aria-expanded', String(panel.dataset.state === 'open'));
  });
</script>
