---
// 편집 화면 자리. 로그인은 Vercel 배포 연결 때 붙인다(docs/AUTH.md).
// 이 페이지는 서버에서 렌더링되며, 환경 변수의 이메일 목록을 브라우저로 보내지 않는다.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { parseMembers } from '../../lib/auth/roles';
// import.meta.env 는 빌드 시 값이 번들에 박히므로 쓰지 않는다. 실행 시점의 process.env 만 읽는다.
const members = parseMembers(process.env.HERE_MEMBERS);
const admins = [...members.values()].filter((r) => r === 'admin').length;
---
<Base title="HERE — 편집">
  <main class="mx-auto max-w-xl px-4 py-16">
    <a href="/" class="font-[family-name:var(--font-latin)] text-[15px] font-extrabold tracking-[0.14em]">HERE</a>
    <h1 class="mt-8 font-[family-name:var(--font-serif)] text-[28px] font-semibold">편집</h1>
    <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-2)]">로그인은 아직 연결되지 않았습니다. 배포를 연결할 때 Google 로그인을 붙이고, 등록된 이메일만 들어올 수 있게 합니다.</p>
    <dl class="mt-8 grid grid-cols-2 gap-3 text-[14px]">
      <div class="rounded-2xl bg-white p-4 shadow-[0_0_0_1px_rgb(0_0_0/.06)]"><dt class="text-[var(--color-ink-3)]">등록된 계정</dt><dd class="mt-1 text-[22px] font-bold tnum">{members.size} / 5</dd></div>
      <div class="rounded-2xl bg-white p-4 shadow-[0_0_0_1px_rgb(0_0_0/.06)]"><dt class="text-[var(--color-ink-3)]">관리자</dt><dd class="mt-1 text-[22px] font-bold tnum">{admins}</dd></div>
    </dl>
  </main>
</Base>
