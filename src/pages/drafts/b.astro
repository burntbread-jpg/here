---
import Base from '../../layouts/Base.astro';
import MapShell from '../../components/MapShell.astro';
import DraftBadge from '../../components/DraftBadge.astro';
---
<Base title="HERE — 시안 B">
  <MapShell>
    <div slot="top" class="pointer-events-none absolute inset-x-0 top-[62px] z-30 px-3 sm:top-[72px] sm:px-4 md:left-[392px]">
      <div id="chips" class="no-scrollbar pointer-events-auto flex gap-1.5 overflow-x-auto pb-1" role="group" aria-label="분류 거르기"></div>
    </div>
    <div slot="panel" class="flex min-h-0 flex-1 flex-col">
      <div class="px-5 pt-2 pb-3 md:pt-5">
        <div class="flex items-end justify-between">
          <h2 id="sheet-title" class="font-[family-name:var(--font-serif)] text-[22px] font-semibold tracking-[-0.02em]">전국</h2>
          <span class="rounded-full bg-black/5 px-2.5 py-1 text-[11.5px] text-[var(--color-ink-2)]">샘플 데이터</span>
        </div>
        <p id="sheet-sub" class="mt-0.5 text-[13px] text-[var(--color-ink-3)] tnum"></p>
        <div id="sheet-bars" class="mt-4 grid grid-cols-1 gap-1.5"></div>
      </div>
      <ul id="sheet-list" class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-t border-[var(--color-line-2)] px-3 pt-2 pb-6"></ul>
    </div>
    <DraftBadge code="b" name="음절 · 행정 묶음" />
  </MapShell>
</Base>
<style is:global>
  .no-scrollbar { scrollbar-width: none; } .no-scrollbar::-webkit-scrollbar { display: none; }
  .chip { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; height: 36px; padding: 0 12px 0 6px; border-radius: 12px;
    background: color-mix(in oklab, var(--color-paper) 90%, transparent); backdrop-filter: blur(10px); box-shadow: 0 0 0 1px rgb(0 0 0 / .07), 0 1px 2px rgb(0 0 0 / .05);
    transition: background-color 160ms var(--ease-out), transform 120ms var(--ease-out); cursor: pointer; }
  .chip:active { transform: scale(.97); }
  .chip-s { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 9px; background: var(--tint); color: var(--ink); font-weight: 700; font-size: 14px; }
  .chip-e { font-family: var(--font-latin); font-size: 12px; font-weight: 600; color: var(--color-ink-2); letter-spacing: .01em; }
  .chip[aria-pressed='false'] { opacity: .5; } .chip[aria-pressed='false'] .chip-s { background: rgb(0 0 0 / .05); color: var(--color-ink-3); }
  .rb { width: var(--s); height: var(--s); border: 0; padding: 0; background: none; cursor: pointer; transition: transform 160ms var(--ease-out); }
  @media (hover: hover) { .rb:hover { transform: scale(1.05); } }
  .rb-ring { position: absolute; inset: 0; border-radius: 999px; box-shadow: 0 2px 8px rgb(0 0 0 / .14); }
  .rb-core { position: absolute; inset: 5px; border-radius: 999px; background: #fff; display: grid; place-content: center; text-align: center; line-height: 1.05; }
  .rb-core b { font-family: var(--font-latin); font-weight: 800; font-size: 15px; letter-spacing: -.02em; }
  .rb-lg .rb-core b { font-size: 18px; }
  @media (max-width: 767.98px) { .rb-core { inset: 4px; } .rb-core b, .rb-lg .rb-core b { font-size: 13px; } .rb-core i { font-size: 9.5px; } }
  .rb-core i { font-style: normal; font-size: 11px; color: var(--color-ink-3); font-weight: 600; margin-top: 1px; }
  .rb-name { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); margin-top: 3px; font-size: 11.5px; font-weight: 600; color: var(--color-ink-2); white-space: nowrap;
    text-shadow: 0 0 3px var(--color-land), 0 0 3px var(--color-land); }
  .dot { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 999px; border: 2px solid #fff; color: #fff; font-size: 12.5px; font-weight: 700;
    box-shadow: 0 1px 4px rgb(0 0 0 / .25); cursor: pointer; padding: 0; transition: transform 140ms var(--ease-out); }
  @media (hover: hover) { .dot:hover { transform: scale(1.15); } }
  .dot-n { width: 34px; height: 34px; }
  .dot-n b { position: absolute; inset: 4px; border-radius: 999px; background: #fff; color: var(--color-ink); display: grid; place-items: center; font-family: var(--font-latin); font-size: 12px; font-weight: 800; }
</style>
<script>
  import { initVariantB } from '../../scripts/map/variant-b';
  initVariantB();
</script>
