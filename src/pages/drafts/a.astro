---
import Base from '../../layouts/Base.astro';
import MapShell from '../../components/MapShell.astro';
import DraftBadge from '../../components/DraftBadge.astro';
---
<Base title="HERE — 시안 A">
  <MapShell>
    <div slot="panel" class="flex min-h-0 flex-1 flex-col">
      <div class="flex items-end justify-between px-5 pt-2 pb-3 md:pt-5">
        <div>
          <h2 id="sheet-title" class="text-[20px] font-bold tracking-[-0.02em] tnum">항목</h2>
          <p id="sheet-sub" class="mt-0.5 text-[13px] text-[var(--color-ink-3)]"></p>
        </div>
        <span class="rounded-full bg-black/5 px-2.5 py-1 text-[11.5px] text-[var(--color-ink-2)]">샘플 데이터</span>
      </div>
      <ul id="sheet-list" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 pb-6"></ul>
    </div>
    <DraftBadge code="a" name="사진 핀" />
  </MapShell>
</Base>
<style is:global>
  .pin { display: block; width: 58px; height: 58px; padding: 0; border: 0; background: none; cursor: pointer;
    transition: transform 160ms var(--ease-out); }
  .pin::after { content: ''; position: absolute; left: 50%; bottom: -5px; width: 10px; height: 10px; background: #fff; transform: translateX(-50%) rotate(45deg);
    box-shadow: 2px 2px 3px rgb(0 0 0 / .12); border-radius: 0 0 2px 0; }
  .pin-thumb { position: absolute; inset: 0; border-radius: 14px; border: 3px solid #fff; box-shadow: 0 2px 8px rgb(0 0 0 / .18), 0 0 0 .5px rgb(0 0 0 / .12); z-index: 1; }
  .pin-count { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; color: #fff; font-family: var(--font-latin); font-weight: 800; letter-spacing: -0.03em;
    text-shadow: 0 1px 2px rgb(0 0 0 / .35), 0 0 10px rgb(0 0 0 / .25); }
  .pin-cat { position: absolute; right: -6px; top: -6px; z-index: 2; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 8px; border: 2px solid #fff;
    color: #fff; font-size: 11.5px; font-weight: 700; }
  @media (hover: hover) { .pin:hover { transform: translateY(-2px); } }
  .pin:active { transform: scale(.96); }
  @media (max-width: 767.98px) { .pin { width: 46px; height: 46px; } .pin-thumb { border-radius: 11px; border-width: 2.5px; } .pin-count.text-\[24px\] { font-size: 19px; } .pin-count.text-\[21px\] { font-size: 17px; } }
  .pin.is-selected .pin-thumb { border-color: var(--color-focus); box-shadow: 0 0 0 2px #fff, 0 6px 16px rgb(36 87 230 / .35); }
  .pin.is-selected::after { background: var(--color-focus); }
  .pin.is-selected { z-index: 99999 !important; }
  .pin:focus-visible { outline: none; } .pin:focus-visible .pin-thumb { border-color: var(--color-focus); }
</style>
<script>
  import { initVariantA } from '../../scripts/map/variant-a';
  initVariantA();
</script>
