---
import Base from '../../layouts/Base.astro';
import MapShell from '../../components/MapShell.astro';
---
<Base title="HERE — 시안 C">
  <MapShell current="course">
    <div slot="panel" class="flex min-h-0 flex-1 flex-col">
      <div class="px-5 pt-1 pb-4 md:px-6 md:pt-6">
        <div class="flex items-baseline justify-between">
          <p class="eyebrow !tracking-[0.08em]">코스</p>
          <p class="eyebrow !tracking-[0.08em]">샘플 데이터</p>
        </div>
        <h2 class="display mt-3 text-[30px] leading-[1.15] md:text-[34px]">함께 들르는 곳</h2>
        <p class="mt-1.5 text-[13px] text-[var(--color-caption)]">작성자가 직접 순서를 정해 이은 코스만 선으로 보여요</p>
      </div>
      <ul id="course-list" class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-t border-[var(--color-linen)] px-5 pb-6 md:px-6"></ul>
    </div>
  </MapShell>
</Base>
<style is:global>
  .mode { color: var(--color-ink-2); transition: background-color 160ms var(--ease-out), color 160ms; }
  .mode[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .course { transition: background-color 160ms var(--ease-out); }
  .course:hover { background: transparent; }
  .course { border-bottom: 1px solid var(--color-linen); border-radius: 0 !important; padding: 16px 0 !important; }
  .course[aria-current='true'] { box-shadow: inset 2px 0 0 var(--color-ink); padding-left: 12px !important; }
  .stop { display: flex; align-items: center; gap: 0; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; transition: opacity 200ms, transform 140ms var(--ease-out); }
  .stop b { display: grid; place-items: center; min-width: 26px; height: 26px; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-family: var(--f-num); font-size: 12px; font-weight: 500;
    border: 2px solid var(--color-land); box-shadow: 0 2px 6px rgb(0 0 0 / .25); position: relative; z-index: 1; }
  .stop span { margin-left: -6px; padding: 0 7px 0 10px; height: 22px; display: grid; place-items: center; border-radius: 0 999px 999px 0; background: var(--color-land); color: var(--ink); font-size: 12px; font-weight: 700;
    box-shadow: 0 1px 4px rgb(0 0 0 / .18); }
  .stop.is-dim { opacity: .55; } .stop.is-dim b { background: #8C867B; }
  @media (hover: hover) { .stop:hover { transform: translateY(-1px); } }
</style>
<script>
  import { initVariantC } from '../../scripts/map/variant-c';
  initVariantC();
</script>

