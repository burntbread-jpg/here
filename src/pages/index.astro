---
// 홈 — "한지 바느질 지도"(3D). 시·도를 누르면 /map 으로 들어간다. 설명은 docs/HOME3D.md
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CATEGORIES } from '../data/categories';
import { getData } from '../lib/data';
const { places, courses, source } = await getData();
const count = (id: string) => places.filter((p) => p.primary === id).length;
---
<Base title="HERE — 가까운 곳을 찍고 잇는 지도">
  <div class="relative h-dvh w-full overflow-hidden">
    <div id="scene" class="absolute inset-0" aria-hidden="true"></div>
    <div id="labels" class="pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <SiteHeader current="home" />

    <section class="hero pointer-events-none absolute inset-x-0 bottom-0 z-20 px-4 pb-5 sm:px-6 sm:pb-6">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="pointer-events-auto max-w-[30rem]">
          <p class="eyebrow">{places.length}곳 · {courses.length}개의 코스{source === 'sample' && ' · 샘플 데이터'}</p>
          <h2 class="display mt-3 text-[34px] leading-[1.12] sm:text-[46px]">가까운 곳을<br />찍고, 잇다</h2>
          <p class="mt-3 text-[14px] leading-relaxed text-[var(--color-caption)]">한지를 겹쳐 만든 한반도. 장소가 많은 곳일수록 높이 쌓이고, 코스는 청실·홍실로 꿰맸어요.</p>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <a href="/map" class="hero-btn hero-btn-solid">지도로 보기</a>
            <a href="/places" class="hero-btn">목록</a>
            <button type="button" id="mode" class="hero-btn" aria-pressed="false">밤</button>
            <button type="button" id="skip" class="hero-btn hero-btn-quiet">건너뛰기</button>
          </div>
        </div>
        <ul class="legend pointer-events-auto flex flex-wrap gap-x-4 gap-y-1.5 md:max-w-[22rem] md:justify-end" aria-label="분류">
          {CATEGORIES.map((c) => (
            <li><a href={`/places/${c.id}`} class="flex items-center gap-1.5 text-[12.5px]"><span class="knot" style={`--ink:${c.ink}`}></span><span class="display text-[14px]">{c.syllable}</span><span class="num text-[var(--color-caption)]">{count(c.id)}</span></a></li>
          ))}
        </ul>
      </div>
      <p id="hint" class="mt-4 hidden text-[12px] text-[var(--color-caption)] md:block">시·도를 누르면 그 지역 지도로 들어가요 · 끌어서 돌리고, 휠로 가까이</p>
    </section>

    <noscript><p class="absolute inset-0 grid place-items-center">3D 홈은 JavaScript가 필요해요. <a href="/map" class="underline">지도로 보기</a></p></noscript>
  </div>
</Base>
<style is:global>
  html[data-scene='night'] { --color-ink: #EDE9E1; --color-caption: #A9A49A; --color-paper: #121211; --color-linen: #3A3935; --color-land: #272725; }
  html[data-scene='night'] body { background: #121211; }
  .hero { background: linear-gradient(to top, color-mix(in oklab, var(--color-paper) 92%, transparent) 0%, color-mix(in oklab, var(--color-paper) 60%, transparent) 55%, transparent 100%); padding-top: 120px; }
  .hero-btn { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; font-size: 14px; border: 1px solid var(--color-ink); border-radius: 2px; color: var(--color-ink);
    background: color-mix(in oklab, var(--color-paper) 70%, transparent); transition: background-color 160ms var(--ease-out), color 160ms, transform 120ms var(--ease-out); cursor: pointer; }
  .hero-btn:hover { background: var(--color-ink); color: var(--color-paper); }
  .hero-btn:active { transform: scale(.97); }
  .hero-btn-solid { background: var(--color-ink); color: var(--color-paper); }
  .hero-btn-quiet { border-color: transparent; color: var(--color-caption); }
  .knot { width: 9px; height: 9px; border-radius: 999px; background: var(--ink); box-shadow: inset 0 -1.5px 0 rgb(0 0 0 / .22); }
  html[data-scene='night'] .knot { box-shadow: 0 0 8px var(--ink); }
  .r3-label { position: absolute; left: 0; top: 0; display: flex; align-items: baseline; gap: 5px; white-space: nowrap; font-size: 11.5px; color: var(--color-ink);
    padding: 2px 6px; border-radius: 2px; transition: opacity 300ms, background-color 160ms; will-change: transform; }
  .r3-label b { font-weight: 500; }
  .r3-label .num { color: var(--color-caption); font-size: 11px; }
  .r3-label.is-on { background: var(--color-ink); color: var(--color-paper); }
  .r3-label.is-on .num { color: inherit; opacity: .75; }
  html[data-tour='on'] #skip { display: inline-flex; } #skip { display: none; }
  @media (max-width: 767.98px) { .r3-label { font-size: 10.5px; padding: 1px 4px; } .legend { gap: 4px 12px; } }
</style>
<script>
  import { initHome3D } from '../scripts/home3d/scene';
  const host = document.getElementById('scene')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const q = new URLSearchParams(location.search);
  let mode: 'day' | 'night' = q.get('mode') === 'night' ? 'night' : 'day';
  try { if (!q.get('mode') && localStorage.getItem('here-scene') === 'night') mode = 'night'; } catch {}
  const btn = document.getElementById('mode')!;
  const sync = () => { btn.textContent = mode === 'night' ? '낮' : '밤'; btn.setAttribute('aria-pressed', String(mode === 'night')); };
  sync();
  const hasGL = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
  if (!hasGL) { location.replace('/map'); }
  else {
    if (!reduced && !q.has('still')) document.documentElement.dataset.tour = 'on';
    const frame = q.has('frame') ? Number(q.get('frame')) : undefined;
    const api = await initHome3D(host, { mode, reduced: reduced || q.has('still'), frame });
    btn.addEventListener('click', () => { mode = mode === 'night' ? 'day' : 'night'; api.setMode(mode); sync(); try { localStorage.setItem('here-scene', mode); } catch {} });
    const skip = () => { api.skip(); document.documentElement.dataset.tour = 'off'; };
    document.getElementById('skip')!.addEventListener('click', skip);
    host.addEventListener('pointerdown', skip);
    setTimeout(() => (document.documentElement.dataset.tour = 'off'), 11000);
  }
</script>
