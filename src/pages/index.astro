---
import Base from '../layouts/Base.astro';
import MapShell from '../components/MapShell.astro';
---
<Base title="HERE — 국내 장소 지도">
  <MapShell>
    <div slot="top" class="pointer-events-none absolute inset-x-0 top-[52px] z-30 px-4 sm:top-[60px] sm:px-6 md:left-[408px]">
      <div id="chips" class="no-scrollbar pointer-events-auto flex gap-1 overflow-x-auto py-1" role="group" aria-label="분류 거르기"></div>
    </div>
    <div slot="panel" class="flex min-h-0 flex-1 flex-col">
      <div class="px-5 pt-1 pb-4 md:px-6 md:pt-6">
        <div class="flex items-baseline justify-between">
          <p id="sheet-level" class="eyebrow !tracking-[0.08em]">시·도별</p>
          <p class="eyebrow !tracking-[0.08em]">샘플 데이터</p>
        </div>
        <h2 id="sheet-title" class="display mt-3 text-[30px] leading-[1.15] md:text-[34px]">전국</h2>
        <p id="sheet-sub" class="mt-1.5 text-[13px] text-[var(--color-caption)] tnum"></p>
        <div id="sheet-bars" class="mt-5 hidden flex-col gap-[7px] md:flex"></div>
      </div>
      <ul id="sheet-list" class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-t border-[var(--color-linen)] px-5 pb-6 md:px-6"></ul>
    </div>
  </MapShell>
</Base>
<style is:global>
  .no-scrollbar { scrollbar-width: none; } .no-scrollbar::-webkit-scrollbar { display: none; }
  .chip { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; height: 34px; padding: 0 11px 0 5px; border-radius: 3px;
    background: var(--color-paper); border: 1px solid var(--color-linen); cursor: pointer;
    transition: border-color 160ms var(--ease-out), opacity 160ms var(--ease-out), transform 120ms var(--ease-out); }
  @media (hover: hover) { .chip:hover { border-color: var(--color-taupe); } }
  .chip:active { transform: scale(.97); }
  .chip-s { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 2px; background: var(--tint); color: var(--ink); font-size: 14px; }
  .chip-e { font-family: var(--f-latin); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--color-caption); }
  .chip[aria-pressed='false'] { opacity: .45; } .chip[aria-pressed='false'] .chip-s { background: transparent; color: var(--color-caption); }
  @media (max-width: 767.98px) { .chip { height: 40px; } }

  .dist-row { display: flex; align-items: center; gap: 10px; }
  .dist-row > .display { width: 16px; text-align: center; }
  .dist-row > .eyebrow { width: 54px; }

  .row { transition: opacity 160ms; }
  @media (hover: hover) { #sheet-list:hover .row { opacity: .72; } #sheet-list .row:hover { opacity: 1; } }

  /* 지역 묶음: 가는 분류 고리 + 숫자, 이름은 원 아래 */
  .rb { width: var(--s); height: var(--s); border: 0; padding: 0; background: none; cursor: pointer; transition: transform 200ms var(--ease-out); }
  @media (hover: hover) { .rb:hover { transform: scale(1.06); } }
  .rb:active { transform: scale(.97); }
  .rb-ring { position: absolute; inset: 0; border-radius: 999px; box-shadow: 0 1px 2px rgb(36 35 31 / .10), 0 4px 12px -4px rgb(36 35 31 / .18); }
  .rb-core { position: absolute; inset: 3px; border-radius: 999px; background: var(--color-land); display: grid; place-content: center; }
  .rb-core b { font-size: 14px; color: var(--color-ink); }
  .rb-lg .rb-core b { font-size: 16px; }
  .rb-name { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); margin-top: 4px; font-size: 11.5px; font-weight: 500; color: var(--color-ink); white-space: nowrap;
    text-shadow: 0 0 2px var(--color-land), 0 0 4px var(--color-land), 0 0 6px var(--color-land); }
  .dot { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; border: 1.5px solid var(--color-land); color: #fff; font-size: 12.5px;
    box-shadow: 0 1px 3px rgb(36 35 31 / .25); cursor: pointer; padding: 0; transition: transform 160ms var(--ease-out); }
  @media (hover: hover) { .dot:hover { transform: scale(1.15); } }
  .dot-n { width: 32px; height: 32px; border: 0; }
  .dot-n b { position: absolute; inset: 3px; border-radius: 999px; background: var(--color-land); color: var(--color-ink); display: grid; place-items: center; font-size: 12px; }
  @media (max-width: 767.98px) { .rb-core b, .rb-lg .rb-core b { font-size: 12.5px; } .rb-name { font-size: 11px; } }
</style>
<script>
  import { initHomeMap } from '../scripts/map/home-map';
  initHomeMap();
</script>

