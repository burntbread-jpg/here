---
import '../styles/global.css';
// scroll: 지도 화면이 아닌, 아래로 읽는 페이지(목록·상세)
interface Props { title?: string; description?: string; scroll?: boolean }
const { title = 'HERE', description = '국내의 맛·쉼·멋·길을 지도 위에 찍고 잇는 기록.', scroll = false } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4F4F1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts/here-fonts.css">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body class={scroll ? 'min-h-dvh' : 'h-dvh overflow-hidden'}>
    <slot />
  </body>
</html>
