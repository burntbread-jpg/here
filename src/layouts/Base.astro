---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'HERE', description = '국내의 맛·쉼·멋·길을 지도 위에 찍고 잇는 기록.' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F3ED" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      // 글씨체 후보 비교용: ?type=1|2|3 (시안 확정 후 삭제)
      (function () { var t = new URLSearchParams(location.search).get('type'); if (t) document.documentElement.dataset.type = t; })();
    </script>
  </head>
  <body class="h-dvh overflow-hidden">
    <slot />
  </body>
</html>
