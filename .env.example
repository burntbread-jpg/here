# 이 파일은 예시다. 실제 값은 .env(로컬) 또는 Vercel 환경 변수에만 넣고 커밋하지 않는다.

# Supabase (docs/AUTH.md §5). URL과 anon 키는 브라우저에 노출돼도 되는 공개 값이지만,
# 권한은 DB의 RLS가 지킨다. SERVICE_ROLE_KEY 는 절대 PUBLIC_ 이름으로 두지 말 것.
PUBLIC_SUPABASE_URL="https://<프로젝트>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY=""
VERCEL_DEPLOY_HOOK_URL=""   # 서버 전용. Vercel Deploy Hook 주소
